# Settings of an additional account. Copy to accounts/<label>.env and fill in;
# the file name must match ACCOUNT_LABEL inside - make checks this. Account
# files are not committed to git: they hold real phone numbers.
#
# Only what is specific to the account goes here. Everything else - the sending
# window, pauses, service recipients, Telegram application keys - comes from
# src/.env and must match across all processes: these settings take part in the
# daily spend count and in the guards.
#
# Setup order: make account-up label=<label>, then
# make account-authorize label=<label> (Telegram sends a code), then
# make account-live label=<label>. In full: docs/runbook-account.md.

# Account label: a row in accounts is created for it on first start. Unique per
# account; it must not be changed after the first run - the daily spend, the
# stop flag and the claimed queue rows are tied to it.
ACCOUNT_LABEL=second

# Phone of the account in international format. Needed both for login and in
# live mode.
TELEGRAM_PHONE=

# Telegram application keys: obtained on my.telegram.org for the phone number of
# this account. Each account has its own; they are not inherited from the main
# stack.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Daily cap of this account. It applies only when the row is first created:
# afterwards the cap lives in the database, and changing the variable does not
# change it. Empty means 20.
ACCOUNT_DAILY_LIMIT=20

# The account's own proxy, if accounts are split across different addresses.
# Empty means sending goes from the same address as the main stack.
TELEGRAM_PROXY_URL=
