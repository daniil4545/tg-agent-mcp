# Настройки дополнительного аккаунта. Скопировать в accounts/<метка>.env и
# заполнить; имя файла обязано совпасть с ACCOUNT_LABEL внутри - это проверяет
# make. Файлы аккаунтов в гит не попадают: в них номера живых телефонов.
#
# Здесь только то, что у аккаунта своё. Всё остальное - окно отправки, паузы,
# служебные адресаты, ключи приложения Telegram - приходит из src/.env и обязано
# совпадать у всех процессов: эти настройки участвуют в счёте дневного расхода и
# в рубежах.
#
# Порядок подключения: make account-up label=<метка>, затем
# make account-authorize label=<метка> (Telegram пришлёт код), затем
# make account-live label=<метка>. Полностью - docs/runbook-account.md.

# Метка аккаунта: под неё заводится строка в accounts при первом старте. Своя у
# каждого аккаунта, менять после первого запуска нельзя - к ней привязаны
# дневной расход, стоп и взятые строки очереди.
ACCOUNT_LABEL=second

# Телефон аккаунта в международном формате. Нужен и при входе, и в живом режиме.
TELEGRAM_PHONE=

# Ключи приложения Telegram: берутся на my.telegram.org под номером этого
# аккаунта. Свои у каждого аккаунта - от главного контура не наследуются.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# Дневной потолок этого аккаунта. Применяется только при первом создании строки:
# дальше потолок живёт в БД, и смена переменной его не меняет. Пусто - 20.
ACCOUNT_DAILY_LIMIT=20

# Свой прокси аккаунта, если аккаунты разводятся по разным адресам. Пусто -
# отправка идёт с того же адреса, что и у основного контура.
TELEGRAM_PROXY_URL=
