# Settings for the local live stack (docker-compose.local.yml).
# Copy to src/.env and fill in. The .env file is not committed to git.

# Password of the local campaign database. Any long string; it cannot be
# changed after the database is created - the password is already stored in its
# role.
POSTGRES_PASSWORD=

# Token of the MCP endpoint: it is also put into TG_AGENT_MCP_TOKEN of the
# environment, from where the .mcp.json of the campaigns project reads it.
MCP_TOKEN=

# Agent access: a second token. With it only tg_send and tg_read are visible,
# and they write only to the listed test accounts - the service itself refuses
# anything else. The token is also kept in the Keychain as
# tg-agent-mcp/mcp-agent (MCP_AGENT_TOKEN), from where the tg-agent server in
# Claude Code takes it. Empty means no access.
MCP_AGENT_TOKEN=
AGENT_ALLOW_LIST=

# Account label: a row in accounts is created for it. A second account is a
# second stack with another label.
ACCOUNT_LABEL=sasha

# Daily cap of the account. It applies only when the account row is first
# created: afterwards the cap lives in the database (accounts.daily_limit), and
# changing this variable with a restart does not change it - the effective
# number is shown by status, and the service reports a mismatch as a warning in
# the log at startup. To raise the cap of a live account, see
# docs/runbook-account.md.
ACCOUNT_DAILY_LIMIT=20

# Pause between sender iterations: a random value from this range. The pause is
# the whole iteration, not just the gap between messages: it is when the sender
# notices a campaign start, the window opening and an emptied queue, so the
# start command does not act instantly but within SEND_PAUSE_MAX.
# 10-30 minutes is the pace of the invitation pilot: 20 messages with an
# average pause of 20 minutes take about 6 hours 20 minutes and fit in the
# 10:00-19:00 window.
SEND_PAUSE_MIN=10m
SEND_PAUSE_MAX=30m

# dry-run writes to the log instead of sending. live is switched on after
# logging in to the account and a pilot, and only together with ENV=prod.
TRANSPORT=dry-run

# Owner's service recipients, comma-separated: the accounts used to test the
# mailing. The service messages them outside the window, on an exhausted cap,
# and repeatedly - neither a campaign nor tg_send holds them back, and they do
# not spend the cap. The stop list and the account stop apply to them as to
# everyone, so no foreign usernames belong here. Empty keeps the service
# behavior exactly as before.
#
# In dev the same list also works as a transport guard: nobody outside the
# list is reached. In prod the list is not a transport guard - the live mailing
# follows the campaign list.
DEV_ALLOW_LIST=

# Evening campaign digest. DIGEST_ACCOUNT is the label of the account that sends
# it: there are several senders, and without a label the digest arrives from one
# chat or another at random. DIGEST_TO lists its recipients; the list must be
# inside DEV_ALLOW_LIST, otherwise the digest becomes a cold touch and runs into
# the sending window, which is closed by its time. Empty in both means any
# sender sends to all service recipients.
DIGEST_ACCOUNT=
DIGEST_TO=

# Live account credentials. The application keys are obtained on my.telegram.org
# for the same phone number; in dry-run they are not read at all.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_PHONE=

# Loopback ports: MCP and healthcheck. Change them if a neighbour occupies them.
MCP_PORT=8087
HEALTH_PORT=8088
