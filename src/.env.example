# Настройки локального боевого контура (docker-compose.local.yml).
# Скопировать в src/.env и заполнить. Файл .env в гит не попадает.

# Пароль локальной базы кампаний. Любая длинная строка; менять после создания
# базы нельзя - пароль уже записан в её роль.
POSTGRES_PASSWORD=

# Токен MCP-эндпоинта: его же кладём в TG_AGENT_MCP_TOKEN окружения, откуда
# читает .mcp.json проекта campaigns.
MCP_TOKEN=

# Агентский доступ: второй токен, с ним видны только tg_send и tg_read, и
# пишут они только перечисленным тестовым аккаунтам - отказывает сам сервис.
# Токен лежит и в Keychain tg-agent-mcp/mcp-agent (MCP_AGENT_TOKEN), откуда
# его берёт сервер tg-agent в Claude Code. Пусто - доступа нет.
MCP_AGENT_TOKEN=
AGENT_ALLOW_LIST=

# Метка аккаунта: под неё заводится строка в accounts. Второй аккаунт - второй
# контур с другой меткой.
ACCOUNT_LABEL=sasha

# Дневной потолок аккаунта. Применяется только при первом создании строки
# аккаунта: дальше потолок живёт в БД (accounts.daily_limit), и смена этой
# переменной с перезапуском его не меняет - действующее число показывает status,
# а расхождение сервис называет предупреждением в логе при старте. Поднять
# потолок живому аккаунту - docs/runbook-account.md.
ACCOUNT_DAILY_LIMIT=20

# Пауза между витками отправщика: случайное число из этого промежутка. Пауза -
# это весь виток, а не только промежуток между письмами: на ней же отправщик
# замечает старт кампании, открытие окна и опустевшую очередь, поэтому команда
# start срабатывает не мгновенно, а в пределах SEND_PAUSE_MAX.
# 10-30 минут - темп пилота приглашений: 20 писем при средней паузе 20 минут
# занимают около 6 часов 20 минут и укладываются в окно 10:00-19:00.
SEND_PAUSE_MIN=10m
SEND_PAUSE_MAX=30m

# dry-run - лог вместо отправки. live включается после входа в аккаунт и
# пилота, и только вместе с ENV=prod.
TRANSPORT=dry-run

# Служебные адресаты владельца через запятую: аккаунты, которыми проверяют
# рассылку. Им сервис пишет и вне окна, и на исчерпанном потолке, и повторно -
# ни кампания, ни tg_send их не удерживают, а расход потолка они не тратят.
# Стоп-лист и стоп аккаунта на них действуют как на всех, поэтому чужих ников
# здесь быть не должно. Пусто - поведение сервиса ровно прежнее.
#
# В dev тот же список работает вторым делом как рубеж транспорта: наружу не
# уходит никто, кроме перечисленных. В prod рубежом транспорта список не
# является - боевая рассылка идёт по списку кампании.
DEV_ALLOW_LIST=

# Вечерняя сводка по кампании. DIGEST_ACCOUNT - метка аккаунта, который её
# отправляет: отправщиков несколько, и без метки сводка приходит то из одного
# чата, то из другого. DIGEST_TO - её получатели; список обязан быть внутри
# DEV_ALLOW_LIST, иначе сводка станет холодным касанием и упрётся в закрытое к
# её времени окно отправки. Пусто у обеих - шлёт любой отправщик всем
# служебным адресатам.
DIGEST_ACCOUNT=
DIGEST_TO=

# Доступы к живому аккаунту. Ключи приложения берутся на my.telegram.org под
# тем же номером; в dry-run не читаются вовсе.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=
TELEGRAM_PHONE=

# Порты на петле: MCP и healthcheck. Меняются, если заняты соседом.
MCP_PORT=8087
HEALTH_PORT=8088
